# 스테이징 자동 세팅 입력 (scripts/setup-staging.mjs). 이 파일을 .env.staging 으로 복사해서 채운다 — .env.staging 은 git에 안 올라간다.

# ── 꼭 필요 (2개) ─────────────────────────────
# supabase.com/dashboard/account/tokens → "Generate new token"
SUPABASE_ACCESS_TOKEN=
# vercel.com/account/tokens → "Create Token" (팀 계정이면 아래 VERCEL_TEAM_ID 도)
VERCEL_TOKEN=

# ── 있으면 넣기 (없어도 세팅은 된다 — 해당 기능만 꺼진 채) ──
# 메일 알림: resend.com API Keys + 인증한 도메인의 발신 주소
RESEND_API_KEY=
MAIL_FROM=
# 상품 정보 번역: console.anthropic.com API Keys
ANTHROPIC_API_KEY=
# 카카오 로그인: developers.kakao.com 앱 → REST API 키 / Client Secret
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# 위아더 내부 WeCom 그룹 봇 주소
WECOM_WEBHOOK_URL=

# ── 선택 ──
VERCEL_TEAM_ID=
SUPABASE_ORG_ID=
STAGING_NAME=osle-select-staging

# ── 아래는 스크립트가 자동으로 덧붙인다 (손대지 않기) ──
